{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev Server",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"],
      "group": "build"
    },
    {
      "label": "DB: Push Schema",
      "type": "npm",
      "script": "db:push",
      "problemMatcher": []
    },
    {
      "label": "DB: Seed Data",
      "type": "npm",
      "script": "db:seed",
      "problemMatcher": [],
      "dependsOn": ["DB: Push Schema"]
    },
    {
      "label": "Run Integration Tests",
      "type": "npm",
      "script": "test:integration",
      "problemMatcher": [
        {
          "base": "$tsc",
          "owner": "vitest",
          "pattern": {
            "regexp": "^\\s*(\\d+)\\s+\\|\\s+([^\\s]+)\\s+›\\s+(.*)$",
            "file": 2,
            "location": 1,
            "message": 3
          }
        }
      ],
      "group": "test"
    },
    {
      "label": "Run E2E Tests (UI)",
      "type": "npm",
      "script": "test:e2e",
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
