{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Debug Server (Edge)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    },
    {
      "name": "Next.js: Debug Client",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000"
    },
    {
      "name": "Debug Vitest (Integration)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test:integration", "--", "--run", "${file}"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Playwright (E2E)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["playwright", "test", "${relativeFile}"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "Drizzle Studio",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run db:studio"
    }
  ],
  "compounds": [
    {
      "name": "Full-Stack Debug",
      "configurations": ["Next.js: Debug Server (Edge)", "Next.js: Debug Client"]
    }
  ]
}
