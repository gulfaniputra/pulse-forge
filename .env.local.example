# Neon PostgreSQL pooled connection string from the development branch
DATABASE_URL="NEON_CONNECTION_STRING"

# Neon PostgreSQL unpooled connection string for Drizzle migrations.
DATABASE_URL_UNPOOLED="NEON_CONNECTION_STRING"

# Global API key for authenticating all Hono API requests (e.g. `openssl rand -base64 32`).
API_KEY="CHANGE_TO_A_SECURE_RANDOM_STRING"

NEXT_PUBLIC_APP_URL=http://localhost:3000
